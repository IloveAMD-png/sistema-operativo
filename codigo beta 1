def main():
    limpiar_pantalla()
    base_ia = cargar_ia()

    print("================================")
    print("      Bienvenido a DexOS")
    print("================================")

    if not iniciar_sesion():
        print("\n[!] Acceso denegado. Cerrando sistema...")
        return

    print("\n[+] Acceso concedido.")

    ventana_grafica("DexOS Terminal", f"Versión: {VERSION} | Escribe 'ayuda'")

    while True:
        try:
            comando = input("\nDexOS> ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nApagando DexOS...")
            break

        if not comando:
            continue

        partes = comando.split()
        cmd = partes[0].lower()

        if cmd == "ayuda":
            print("\nComandos disponibles:")
            print("  ayuda                 - Muestra esta lista de comandos")
            print("  ia                    - Abre el asistente conversacional")
            print("  apps                  - Lista las aplicaciones instaladas")
            print("  abrir_app <nombre>    - Ejecuta una aplicación")
            print("  crear_app <nombre>    - Crea una nueva aplicación base")
            print("  juego                 - Inicia el juego")
            print("  clear                 - Limpia la pantalla")
            print("  version               - Muestra la versión actual")
            print("  salir                 - Apaga el sistema")

        elif cmd == "ia":
            modo_ia(base_ia)

        elif cmd == "apps":
            listar_apps()

        elif cmd == "abrir_app":
            if len(partes) >= 2:
                abrir_app(partes[1])
            else:
                print("Uso: abrir_app <nombre>")

        elif cmd == "crear_app":
            if len(partes) >= 2:
                crear_app_template(partes[1])
            else:
                print("Uso: crear_app <nombre>")

        elif cmd == "juego":
            juego()

        elif cmd == "clear":
            limpiar_pantalla()

        elif cmd == "version":
            print(f"DexOS {VERSION}")

        elif cmd == "salir":
            print("Apagando DexOS... ¡Hasta pronto!")
            break

        else:
            print(f"Comando '{cmd}' no reconocido. Escribe 'ayuda'.")

if __name__ == "__main__":
