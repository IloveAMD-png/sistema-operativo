import os
import sys
import json
import subprocess
from difflib import get_close_matches
import random
import time

VERSION = "alpha 0.2"
DIR_DATOS = "datos_ia"
DIR_APPS = "apps"
ARCHIVO_IA = os.path.join(DIR_DATOS, "base.json")

# Asegurar directorios
os.makedirs(DIR_DATOS, exist_ok=True)
os.makedirs(DIR_APPS, exist_ok=True)

# -------------------------------------------------------------
# UTILIDADES GRÁFICAS Y SISTEMA
# -------------------------------------------------------------
def limpiar_pantalla():
    os.system("cls" if os.name == "nt" else "clear")

def ventana_grafica(titulo: str, mensaje: str = ""):
    """Dibuja una ventana ASCII adaptativa según el largo del texto."""
    ancho = max(len(titulo), len(mensaje), 34) + 4
    print("┌" + "─" * ancho + "┐")
    print(f"│ {titulo.center(ancho - 2)} │")
    if mensaje:
        print("├" + "─" * ancho + "┤")
        print(f"│ {mensaje.ljust(ancho - 2)} │")
    print("└" + "─" * ancho + "┘")

# -------------------------------------------------------------
# BASE DE DATOS Y CONOCIMIENTO (IA)
# -------------------------------------------------------------
def cargar_ia() -> dict:
    if os.path.exists(ARCHIVO_IA):
        try:
            with open(ARCHIVO_IA, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def guardar_ia(base_ia: dict):
    with open(ARCHIVO_IA, "w", encoding="utf-8") as f:
        json.dump(base_ia, f, ensure_ascii=False, indent=2)

# -------------------------------------------------------------
# MÓDULOS DE DEXOS
# -------------------------------------------------------------
def modo_ia(base_ia: dict):
    print("\n--- Modo Asistente IA (Escribe 'salir' para volver) ---")
    while True:
        pregunta = input("IA> ").lower().strip()

        if not pregunta:
            continue
        if pregunta == "salir":
            break

        if pregunta in base_ia:
            print(f"DexIA: {base_ia[pregunta]}")
        else:
            # Buscar coincidencias aproximadas
            coincidencias = get_close_matches(pregunta, base_ia.keys(), n=1, cutoff=0.7)
            if coincidencias:
                clave = coincidencias[0]
                print(f"DexIA (asumiendo '{clave}'): {base_ia[clave]}")
            else:
                respuesta = input("DexIA: No sé la respuesta. ¿Qué debería responder?: ").strip()
                if respuesta:
                    base_ia[pregunta] = respuesta
                    guardar_ia(base_ia)
                    print("DexIA: ¡Entendido, conocimiento guardado!")

def listar_apps():
    apps = [f[:-3] for f in os.listdir(DIR_APPS) if f.endswith(".py")]
    print("\nApps disponibles:")
    if not apps:
        print(" (No hay aplicaciones instaladas en la carpeta /apps)")
    for app in apps:
        print(f" • {app}")

def abrir_app(nombre: str):
    ruta = os.path.join(DIR_APPS, f"{nombre}.py")
    if os.path.exists(ruta):
        print(f"Iniciando {nombre}...")
        subprocess.run([sys.executable, ruta])
    else:
        print(f"Error: La app '{nombre}' no existe en {DIR_APPS}/")

def crear_app_template(nombre: str):
    ruta = os.path.join(DIR_APPS, f"{nombre}.py")
    if os.path.exists(ruta):
        print("La app ya existe.")
        return
    with open(ruta, "w", encoding="utf-8") as f:
        f.write(f'# App: {nombre}\nprint("Hola desde la app {nombre}!")\ninput("Presiona Enter para salir...")\n')
    print(f"App '{nombre}.py' creada exitosamente en {DIR_APPS}/")
